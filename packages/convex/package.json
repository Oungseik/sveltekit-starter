{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/convex",
  "description": "Collection of convex queries and mutations",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "convex dev",
    "check": "biome check --write .",
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/_generated/api.d.ts",
      "default": "./src/_generated/api.js"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "convex": "^1.28.0"
  }
}
