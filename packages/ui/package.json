{
  "name": "@repo/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "shadcn": "pnpm dlx shadcn-svelte@latest add",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api"
  },
  "exports": {
    "./*": "./src/lib/components/ui/*/index.js",
    "./css": "./src/app.css",
    "./styles/*": "./src/lib/styles/*.css"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@sveltejs/adapter-auto": "8.0.0-next.3",
    "@sveltejs/kit": "3.0.0-next.20",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "embla-carousel-svelte": "^8.6.0",
    "jsrepo": "^3.8.1",
    "mode-watcher": "^1.1.0",
    "runed": "^0.37.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-easy-crop": "^5.0.1",
    "svelte-sonner": "^1.2.1",
    "svelte-tel-input": "^4.3.2",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*/index.ts"
  }
