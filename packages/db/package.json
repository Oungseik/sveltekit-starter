{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/db",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun run with-env drizzle-kit studio",
    "with-env": "dotenv -e ../../.env --",
    "check": "biome check --write .",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "db:push": "bun --bun run with-env drizzle-kit push",
    "db:studio": "bun --bun run with-env drizzle-kit studio",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun run with-env drizzle-kit migrate"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-beta.12-a5629fb",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "^1.3.9",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.12-a5629fb",
    "drizzle-seed": "^0.3.1",
    "tsdown": "0.21.0-beta.2",
    "typescript": "^5.9.3"
  }
}
