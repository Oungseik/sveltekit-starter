{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "check": "oxlint .",
    "build": "tsdown --no-dts",
    "check-types": "tsc --noEmit",
    "db:push": "bun --bun run with-env drizzle-kit push",
    "db:studio": "bun --bun run with-env drizzle-kit studio",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun run with-env drizzle-kit migrate"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "^1.4.1",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2"
  }
}
