{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": true,
  "sortTailwindcss": true,
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/.svelte-kit",
    "**/.next",
    "**/dist",
    "**/build",
    "**/.turbo",
    "**/dev-dist",
    "**/.zed",
    "**/.vscode",
    "**/routeTree.gen.ts",
    "**/src-tauri",
    "**/.nuxt",
    "bts.jsonc",
    "**/.expo",
    "**/.wrangler",
    "flake.lock",
    "apps/website/src/lib/paraglide"
  ]
}
