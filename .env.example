# vim:set filetype=sh :

# Optional public runtime value. "development" disables oRPC batching for debugging;
# leaving it unset enables batching. Declared in apps/website/src/env.ts.
PUBLIC_ENVIRONMENT=development

# BETTER_AUTH_SECRET is used by Better Auth for signing JWTs and securing sessions.
# Required private build-time value. Use a long, random string; rebuild to change it.
BETTER_AUTH_SECRET=xxx
 
# DATABASE_URL specifies the connection string for the PostgreSQL database.
# Required private build-time value; rebuild to change it.
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
DATABASE_URL=xxx
