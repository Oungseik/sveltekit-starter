{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "check": "pnpm run prepare && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check-types": "pnpm run check",
    "check:watch": "pnpm run prepare && svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api",
    "lint": "oxlint .",
    "test:unit": "bunx --bun vitest",
    "test": "npm run test:unit -- --run --passWithNoTests"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^3.2.0",
    "@lucide/svelte": "^1.70.0",
    "@orpc/client": "2.0.0-beta.48",
    "@orpc/server": "2.0.0-beta.48",
    "@orpc/tanstack-query": "2.0.0-beta.48",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.3.11",
    "arktype": "^2.2.9",
    "better-auth": "^1.7.18",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "mode-watcher": "^1.1.0",
    "rate-limiter-flexible": "^11.3.0",
    "runed": "^0.38.0",
    "svelte-sonner": "^1.2.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.20.6",
    "jsdom": "^31.0.0",
    "mdsvex": "^0.12.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-meta-tags": "^5.0.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "5.1.0"
  }
}
