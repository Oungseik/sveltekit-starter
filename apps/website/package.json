{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/paraglide/*": "./src/lib/paraglide/*.js",
    "#lib/server/*": "./src/lib/server/*.ts",
    "#lib/server/orpc/*": "./src/lib/server/orpc/*.ts",
    "#lib/server/orpc/handlers/*": "./src/lib/server/orpc/handlers/*/index.ts",
    "#lib/utils": "./src/lib/utils/index.ts"
  },
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api",
    "lint": "oxlint .",
    "lint:eslint": "eslint .",
    "test:unit": "bunx --bun vitest",
    "test": "npm run test:unit -- --run --passWithNoTests"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@lucide/svelte": "^1.34.0",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.1.45",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "libphonenumber-js": "^1.13.11",
    "mode-watcher": "^1.1.0",
    "rate-limiter-flexible": "^11.2.0",
    "runed": "^0.37.1",
    "svelte-sonner": "^1.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "8.0.0-next.3",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bits-ui": "^2.19.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "mdsvex": "^0.12.8",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-meta-tags": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "5.0.0-rc.2"
  }
}
