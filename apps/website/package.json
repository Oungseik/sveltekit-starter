{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api",
    "format": "prettier --write . && biome format --write .",
    "lint": "biome lint .",
    "lint:eslint": "prettier --check . && eslint .",
    "test:unit": "bunx --bun vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.0.1",
    "@typescript/native-preview": "7.0.0-dev.20260630.1",
    "bits-ui": "^2.18.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mdsvex": "^0.12.7",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-meta-tags": "^5.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.20.2",
    "@lucide/svelte": "^1.22.0",
    "@orpc/client": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@orpc/tanstack-query": "^1.14.6",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.1.36",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "libphonenumber-js": "^1.13.7",
    "mode-watcher": "^1.1.0",
    "rate-limiter-flexible": "^11.2.0",
    "runed": "^0.37.1",
    "svelte-sonner": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  }
}
