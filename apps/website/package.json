{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/paraglide/*": "./src/lib/paraglide/*.js",
    "#lib/server/*": "./src/lib/server/*.ts",
    "#lib/server/orpc/*": "./src/lib/server/orpc/*.ts",
    "#lib/server/orpc/handlers/*": "./src/lib/server/orpc/handlers/*/index.ts",
    "#lib/utils": "./src/lib/utils/index.ts"
  },
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api",
    "lint": "oxlint .",
    "test:unit": "bunx --bun vitest",
    "test": "npm run test:unit -- --run --passWithNoTests"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.29.0",
    "@lucide/svelte": "^1.59.0",
    "@orpc/client": "^1.15.7",
    "@orpc/server": "^1.15.7",
    "@orpc/tanstack-query": "^1.15.7",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.3.3",
    "arktype": "^2.2.8",
    "better-auth": "^1.7.10",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "mode-watcher": "^1.1.0",
    "rate-limiter-flexible": "^11.2.3",
    "runed": "^0.37.1",
    "svelte-sonner": "^1.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bits-ui": "^2.19.5",
    "jsdom": "^30.1.3",
    "mdsvex": "^0.12.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-meta-tags": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "5.0.5"
  }
}
